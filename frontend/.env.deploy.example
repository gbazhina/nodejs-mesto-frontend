# Пример заполнения. Скопируйте этот файл в .env.deploy
# и заполните реальными значениями. Сам .env.deploy
# не должен попадать в репозиторий.

DEPLOY_SERVER=xxx.xxx.xxx.xxx
DEPLOY_USER=your-user
DEPLOY_REPO=git@github.com:your-username/your-repo.git
DEPLOY_BRANCH=main
DEPLOY_PATH=/home/your-user/mesto-frontend
